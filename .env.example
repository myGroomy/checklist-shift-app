# .env.example – contoh file konfigurasi lingkungan
# Salin file ini menjadi .env dan isi nilai yang sesuai untuk lingkungan development

# ---------------------------------------------------------------------------
# Supabase (PostgreSQL + Storage)
# ---------------------------------------------------------------------------
# URL proyek Supabase (e.g. https://xyz.supabase.co)
SUPABASE_URL=
# Public anon key (bisa dipakai di client)
SUPABASE_ANON_KEY=
# Service‑role key (hanya dipakai di server‑side, JANGAN commit)
SUPABASE_SERVICE_ROLE_KEY=
# ---------------------------------------------------------------------------
# JWT / Session
# ---------------------------------------------------------------------------
# Secret untuk menandatangani JWT (httpOnly cookie)
SESSION_SECRET=
# Masa berlaku token (dalam hari)
SESSION_MAX_AGE_DAYS=30

# ---------------------------------------------------------------------------
# PIN / Authentication
# ---------------------------------------------------------------------------
# Pepper untuk hash PIN (random string, harus rahasia)
PIN_PEPPER=
# Batas percobaan salah PIN sebelum lock (default 5)
PIN_MAX_ATTEMPTS=5
# Durasi lock setelah percobaan maksimum (menit)
PIN_LOCK_MINUTES=15

# ---------------------------------------------------------------------------
# Google Drive – arsip PDF mingguan
# ---------------------------------------------------------------------------
# Service Account JSON (base64 atau path ke file)
GOOGLE_SA_PRIVATE_KEY=
# ID folder tujuan di Google Drive (contoh: checklist-shift-archive)
GOOGLE_DRIVE_FOLDER_ID=

# ---------------------------------------------------------------------------
# Next.js / Vercel
# ---------------------------------------------------------------------------
# URL aplikasi (untuk webhook / callback)
NEXT_PUBLIC_APP_URL=
# Port development (opsional, default 3000)
PORT=3000

# ---------------------------------------------------------------------------
# Miscellaneous
# ---------------------------------------------------------------------------
# URL endpoint API (jika dipisah dari Next.js, biasanya sama dengan SUPABASE_URL)
API_BASE_URL=
# Nama branch (untuk multi‑branch, optional)
BRANCH_ID=
